# Required
BOT_TOKEN=
API_ID=
API_HASH=

# At least one admin Telegram user id
ADMIN_IDS=

# Optional
BOT_NAME=StrangerBot
PORT=
LOG_LEVEL=info

# Storage driver: json (default) or mongodb
DB_DRIVER=json
DB_PATH=data/db.json

# MongoDB (used when DB_DRIVER=mongodb)
MONGO_URI=
MONGO_DB=strangerbot
TDLIB_LIBRARY_PATH=lib/libtdjson.so
TDLIB_DATABASE_DIR=data/tdlib/db
TDLIB_FILES_DIR=data/tdlib/files

# Limits
FREE_DAILY_SEARCHES=100
PREMIUM_DAILY_SEARCHES=200
MAX_INTERESTS=5
MAX_BLOCK_LIST=30
MIN_AGE=18
MAX_AGE=80
MAX_RELAY_SIZE=4096

# Daily bonus
DAILY_BONUS_BASE=3
DAILY_BONUS_STEP=1
DAILY_BONUS_MAX=10

# Privacy & safety
CHAT_IDLE_MINUTES=15
FLOOD_LIMIT=10
FLOOD_WINDOW_SECONDS=10
PRIVACY_DELETE_MINUTES=5

# Security
MAX_STRIKES=3
MUTE_MINUTES=5
SEARCH_COOLDOWN_SECONDS=5
CAPTCHA_REQUIRED=true
AUTO_BAN_REPORTS=3
PROTECT_CONTENT=true
BLOCK_FORWARDS=true

# Rewards
REFERRAL_REWARD=5
GIFT_PREMIUM_DAYS=7

# Admin digest (UTC hour)
DIGEST_HOUR=9

# Behaviour
SUPPORT_LINK=https://t.me/+Q493A_VBAUpkMmRl
ICEBREAKER_COOLDOWN=20
LIKE_REWARD=1
DISLIKE_COST=1
MAINTENANCE=false
NOTIFY_ADMINS_ON_REPORT=true